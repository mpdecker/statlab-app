{
  "name": "statlab-monorepo",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm dev -w app",
    "build": "pnpm build -w statlab && pnpm build -w app",
    "build:lib": "pnpm build -w statlab",
    "build:app": "pnpm build -w app",
    "test": "pnpm test -w statlab && pnpm test -w app",
    "test:lib": "pnpm test -w statlab",
    "test:app": "pnpm test -w app",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "coverage": "pnpm exec vitest run --coverage -w statlab",
    "barrel": "node scripts/gen-barrel.mjs",
    "docs": "node scripts/statlab.mjs",
    "docs:list": "node scripts/statlab.mjs list",
    "docs:search": "node scripts/statlab.mjs search",
    "docs:generate": "node scripts/document.mjs",
    "reference:generate": "node scripts/dump-fixtures.mjs && python scripts/gen-reference.py"
  }
}
